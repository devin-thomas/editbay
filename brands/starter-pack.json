{
  "id": "starter-pack",
  "name": "Starter Pack (Devin Thomas / Uppercut Labs)",
  "status": "provisional",
  "source": "starter.devthomas.site src/index.css and index.html, read 2026-09-26. Channel branding is not settled; treat as provisional.",
  "palette": {"background": "#111419", "surface": "#171b21", "surface_2": "#1c2128", "text": "#f3f6fa",
              "text_muted": "#a6b0bf", "line": "#2b323c", "accent": "#2f80ed", "accent_2": null,
              "success": "#71d3a2", "danger": "#f08678",
              "phase_make": "#80d8b0", "phase_build": "#88baff", "phase_grow": "#e8bd7c"},
  "fonts": {"display": {"family": "Geist", "weights": [650, 800], "source": "@fontsource-variable/geist or Google Fonts"},
            "body": {"family": "Geist", "weights": [400, 500]},
            "mono": {"family": "Geist Mono", "weights": [500], "use": "step numbers, code, machine labels"}},
  "type_scale_px_1080p": {"hero": 124, "headline": 76, "body": 44, "label": 26, "min_phone_readable": 36},
  "shape": {"radius_px": [6, 12], "stroke_px": 2, "grid_px": 32,
            "background": "faint 32px grid with a soft blue radial glow", "eyebrow": "uppercase 13px equivalent, 0.11em tracking, 17x2 accent rule"},
  "motion": {"eases": {"enter": "cubic-bezier(.2,.8,.2,1)", "exit": "cubic-bezier(.4,0,1,1)"},
             "min_read_hold_s": 2.5, "default_enter_s": 0.24, "notes": "site uses 0.24 s fades; video can be bolder but stays calm"},
  "devices": {"allowed": ["kinetic type", "terminal and code cards", "step rails", "grid backgrounds", "cards behind text over footage"],
              "forbidden": ["hype slogans", "fake UI that pretends to be a real product screen"]},
  "logo": {"files": ["uppercut-labs-logo.png (starter-pack repo public/)"], "clear_space": "one badge-width",
           "never": ["recolor the badge", "use the badge palette as UI colour"]},
  "audio": {"lufs_explainer": -16, "lufs_reel": -14, "true_peak": -1.0, "music_policy": "own beats, CC0, or CC BY with credit"},
  "voice": {"tone": "first person, plain, reassuring, candid about limits; show then explain; 140-160 wpm",
            "never_say": ["In this video", "like and subscribe", "game-changer"]},
  "notes": "Beginner audience starting from a phone. Privacy-minded. No hype, no upsells."
}
