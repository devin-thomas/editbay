{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "editbay-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-25",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "public",
    "run_worker_first": ["/mcp", "/health", "/docs/*", "/about.json"],
    "not_found_handling": "none"
  },
  "routes": [{"pattern": "editbay.uppercut-labs.com", "custom_domain": true}],
  "observability": {"enabled": false}
}
