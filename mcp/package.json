{
  "name": "editbay-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Free, read-only remote MCP for editbay skills, runbooks and script source.",
  "repository": {
    "type": "git",
    "url": "https://github.com/devin-thomas/editbay.git"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "content": "node scripts/build-content.mjs",
    "dev": "npm run preview",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.scripts.json",
    "test": "npm run content && node --test tests/*.test.ts",
    "build": "npm run content && npm run web:build && wrangler deploy --dry-run --outdir dist",
    "check": "npm run content && npm run web:build && npm run format:check && npm run audit && npm run typecheck && npm test && npm run build",
    "deploy": "npm run check && wrangler deploy",
    "smoke": "node scripts/smoke.mjs",
    "web:build": "node --check public/assets/showcase.js",
    "format:check": "node --check scripts/build-content.mjs && node --check scripts/audit-public.mjs",
    "audit": "node scripts/audit-public.mjs",
    "preview": "npm run content && npm run web:build && wrangler dev --ip 127.0.0.1 --port 8793",
    "test:browser": "node scripts/verify-showcase.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "@fontsource-variable/geist": "5.3.0",
    "@types/node": "latest",
    "esbuild": "0.28.2",
    "playwright": "1.62.1",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "wrangler": "4.152.0"
  },
  "overrides": {
    "miniflare": {
      "undici": "7.30.1"
    }
  }
}
